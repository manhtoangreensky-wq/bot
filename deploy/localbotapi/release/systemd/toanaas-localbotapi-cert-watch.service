[Unit]
Description=TOAN AAS Local Bot API public certificate expiry check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/toanaas-localbotapi/current/release/bin/toanaas-localbotapi-cert-watch
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=
