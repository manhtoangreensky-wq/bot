[Unit]
Description=TOAN AAS Local Bot API self-heal reconcile
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/opt/toanaas-localbotapi/current/release/bin/toanaas-localbotapi-reconcile
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/etc/systemd/system /run/lock /run/docker.sock
