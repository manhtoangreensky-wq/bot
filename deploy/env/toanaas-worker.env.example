# Copy this file to /etc/toanaas-worker.env on the VPS.
# Then run: chmod 600 /etc/toanaas-worker.env
# Never commit a real LOCAL_WORKER_TOKEN.

BOT_API_URL=https://bot-production-2dd7.up.railway.app
LOCAL_WORKER_TOKEN=CHANGE_ME_DO_NOT_COMMIT_REAL_TOKEN
WORKER_ID=vps-1
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_CONCURRENCY=1
WORKER_TMP_DIR=/opt/toanaas/tmp
FFMPEG_MAX_CONCURRENT=1
