# Copy to /etc/toanaas-video-edit-worker.env; set ownership root:root and mode 0600.
# LOCAL_WORKER_BOT_URL is the public HTTPS Railway bot origin reachable from this VPS,
# never Telegram's API origin.
LOCAL_WORKER_BOT_URL=
LOCAL_WORKER_JOB_SCOPE=video_edit_only
VIDEO_EDIT_WORKER_TOKEN=
LOCAL_WORKER_ID=vps-video-edit
VIDEO_PROJECT_QUEUE_ENABLED=false
LOCAL_VIDEO_FAKE_RENDERER_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://tg.toanaas.vn
TELEGRAM_API_PROXY_SECRET=
TELEGRAM_API_PROXY_SECRET_HEADER=X-Toanaas-Proxy-Secret
LOCAL_FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
LOCAL_FFMPEG_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
VIDEO_LOCAL_WORKSPACE_ROOT=/var/lib/toanaas/video-edit
LOCAL_WORKER_MAX_JOB_SECONDS=21600
VIDEO_EDIT_MAX_DEADLINE_SECONDS=21600
